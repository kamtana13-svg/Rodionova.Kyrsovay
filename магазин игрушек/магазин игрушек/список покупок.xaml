<Window x:Class="магазин_игрушек.список_покупок"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Icon="иконка.png" 
        Title="Чеки покупок" Height="500" Width="900">
    <Grid Background="#FFF4E1E1">
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>


        <!-- ФИО -->
        <Label x:Name="FioLabel" Content=""
               HorizontalAlignment="Left" VerticalAlignment="Top"
               Margin="580,1,0,0"
               FontSize="16" FontFamily="Cambria" Width="320"/>

        <!-- Таблица чеков -->
        <DataGrid x:Name="ChecksGrid"
           Margin="10,49,10,26"
           AutoGenerateColumns="False"
           CanUserAddRows="False"
           CanUserDeleteRows="False"
           IsReadOnly="True"
           HeadersVisibility="Column"
           FontFamily="Cambria"
           FontSize="14"
           Background="White"
           RowBackground="White"
           AlternatingRowBackground="#FFF9F0F5">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ Чека" Binding="{Binding Id_chek}"            Width="Auto"/>
                <DataGridTextColumn Header="Дата"   Binding="{Binding Data}"               Width="Auto"/>
                <DataGridTextColumn Header="Итого"  Binding="{Binding Itogovaya_stoimost}" Width="Auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>