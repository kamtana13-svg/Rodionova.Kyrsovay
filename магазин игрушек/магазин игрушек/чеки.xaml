<Window x:Class="магазин_игрушек.чеки"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d" 
                Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="чеки" Height="450" Width="700">
    <Grid Background="#FFF4E1E1">
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>

        <ListBox x:Name="PositionsList"
         Margin="0,35,0,131"
         Background="White" BorderThickness="0"
         FontFamily="Cambria" FontSize="14"
         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1"
                    Margin="0,0,0,10" Padding="10"
                    Background="White" MinWidth="520" Height="100">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2"
                            Width="80" Height="60" VerticalAlignment="Center">
                                <Image Source="{Binding FotoPath}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding Composition}" FontSize="12" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Price}"
                               FontSize="18" VerticalAlignment="Center"
                               HorizontalAlignment="Right" Margin="15,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--ДАТА-->
        <Label Content="Дата:" HorizontalAlignment="Left"
          Margin="20,310,0,0" VerticalAlignment="Top"
          FontFamily="Cambria"
           FontSize="16"/>

        <TextBlock HorizontalAlignment="Left" Margin="85,315,0,0"
          TextWrapping="Wrap" Text="" VerticalAlignment="Top"
          Width="91" FontFamily="Cambria" FontSize="16"/>

        <!--ВРемя-->
        <Label Content="Время:" HorizontalAlignment="Left"
          Margin="20,340,0,0" VerticalAlignment="Top"
          FontFamily="Cambria"
           FontSize="16"/>

        <TextBlock HorizontalAlignment="Left" Margin="85,350,0,0"
          TextWrapping="Wrap" Text="" VerticalAlignment="Top"
          Width="91" FontFamily="Cambria" FontSize="16"/>

        <!--ИТОГ-->
        <Label Content="Итог:" HorizontalAlignment="Left"
          Margin="20,370,0,0" VerticalAlignment="Top"
          FontFamily="Cambria"
           FontSize="16"/>

        <TextBlock HorizontalAlignment="Left" Margin="85,375,0,0"
          TextWrapping="Wrap" Text="" VerticalAlignment="Top"
          Width="91" FontFamily="Cambria" FontSize="16"/>
    </Grid>
</Window>
