           Margin="430,260,0,0" VerticalAlignment="Top"
           FontSize="16" 
           FontFamily="Cambria"/>

        <TextBlock HorizontalAlignment="Left" Margin="555,265,0,0" 
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" 
           Width="200"  FontSize="16" 
           FontFamily="Cambria" Height="20"/>

        <!--КОЛИЧЕСТВО-->
        <Label Content="Количество:" HorizontalAlignment="Left" 
           Margin="430,290,0,0" VerticalAlignment="Top"
           FontSize="16" 
           FontFamily="Cambria"/>

        <TextBlock HorizontalAlignment="Left" Margin="555,295,0,0" 
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" 
           Width="200"  FontSize="16" 
           FontFamily="Cambria" Height="20"/>

        <!--Название-->
        <Label Content="" HorizontalAlignment="Left"
           Margin="98,56,0,0" VerticalAlignment="Top"
           FontSize="16" 
           FontFamily="Cambria" Width="264" />

    </Grid>
