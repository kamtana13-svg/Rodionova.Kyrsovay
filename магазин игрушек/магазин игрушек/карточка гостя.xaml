           FontSize="16" 
           FontFamily="Cambria" />

        <TextBlock HorizontalAlignment="Left" Margin="434,90,0,0" 
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" 
           Width="355"  FontSize="16" 
           FontFamily="Cambria" Height="103"/>

        <!--производитель-->
