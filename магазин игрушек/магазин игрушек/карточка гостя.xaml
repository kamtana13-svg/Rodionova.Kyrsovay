           Margin="430,230,0,0" VerticalAlignment="Top"
           FontSize="16" 
           FontFamily="Cambria"/>

        <TextBlock HorizontalAlignment="Left" Margin="555,235,0,0" 
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" 
           Width="200"  FontSize="16" 
           FontFamily="Cambria" Height="20"/>

