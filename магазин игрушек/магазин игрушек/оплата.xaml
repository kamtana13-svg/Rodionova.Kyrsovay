<Window x:Class="магазин_игрушек.оплата"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
                Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="оплата" Height="450" Width="600">
    <Grid Background="#FFF4E1E1" >
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>

        <Image HorizontalAlignment="Left" Height="297" VerticalAlignment="Top" Width="312"
               Source ="C:\Users\Пользователь\Desktop\учеба\4 курс\курсовая федосеева 2\оплата.png" Margin="152,30,0,0"/>

        <Button Content="Оплатить" HorizontalAlignment="Center" 
           Margin="0,370,0,0" VerticalAlignment="Top"
           Height="40" Width="154" 
           FontSize="16" 
           BorderBrush="#FFDBB2EA"
           BorderThickness="2"
           FontFamily="Cambria"
           Background="{x:Null}" Click="Оплатить"/>

        <Label Content="Итог:" HorizontalAlignment="Left" 
           Margin="203,336,0,0" VerticalAlignment="Top"
           FontSize="16" 
           BorderThickness="0"
           FontFamily="Cambria"
           Background="{x:Null}"/>

        <TextBox x:Name="TotalBox"
           HorizontalAlignment="Left" 
           Margin="252,340,0,0" TextWrapping="Wrap" 
           Text="" VerticalAlignment="Top" Width="166" 
           Height="25" FontSize="16" 
           BorderThickness="0"
           FontFamily="Cambria"
           Background="{x:Null}"
           IsReadOnly="True"/>
    </Grid>
</Window>