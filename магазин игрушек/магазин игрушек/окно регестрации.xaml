<Window x:Class="магазин_игрушек.окно_регестрации"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
                Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="окно_регистрации" Height="450" Width="450">
    <Grid Background="#FFF4E1E1">
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>

        <Button Content="Зарегестрироваться" HorizontalAlignment="Center"
           Margin="0,304,0,0" VerticalAlignment="Top"
           Height="40" Width="186" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}" Click="Войти"/>

        <Label Content="ФИО:" HorizontalAlignment="Left"
            Margin="50,51,0,0" VerticalAlignment="Top"
            FontFamily="Cambria" FontSize="16" Background="{x:Null}"/>
        <TextBox x:Name="FioBox" HorizontalAlignment="Center" Margin="0,84,0,0"
           TextWrapping="Wrap" Text="" VerticalAlignment="Top"
           Height="40" Width="350" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"/>

        <Label Content="Номер телефона:" HorizontalAlignment="Left"
            Margin="50,124,0,0" VerticalAlignment="Top"
            FontFamily="Cambria" FontSize="16" Background="{x:Null}"/>
        <TextBox x:Name="PhoneBox" HorizontalAlignment="Center" Margin="0,157,0,0"
           TextWrapping="Wrap" Text="+7" VerticalAlignment="Top"
           Height="40" Width="350" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"
           MaxLength="12"
           PreviewTextInput="PhoneBox_PreviewTextInput"
           GotFocus="PhoneBox_GotFocus"/>

        <Label Content="Логин:" HorizontalAlignment="Left"
            Margin="55,195,0,0" VerticalAlignment="Top"
            FontFamily="Cambria" FontSize="16" Background="{x:Null}"/>
        <TextBox x:Name="LoginBox" HorizontalAlignment="Center" Margin="0,228,0,0"
           TextWrapping="Wrap" Text="" VerticalAlignment="Top"
           Height="40" Width="350" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"/>
    </Grid>
</Window>