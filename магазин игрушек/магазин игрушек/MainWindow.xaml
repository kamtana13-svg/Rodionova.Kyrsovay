<Window x:Class="магазин_игрушек.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
        Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="Авторизация" Height="425" Width="635">
    <Grid Background="#FFF4E1E1" >
        <Image HorizontalAlignment="Center" Height="425" VerticalAlignment="Top" Width="635"
               Source="C:\Users\Пользователь\Desktop\учеба\4 курс\курсовая федосеева 2\фон.png" Margin="0,-2,0,0"/>
         <!--КНОПКИ-->
        <Button Content="Войти" HorizontalAlignment="Left"
           Margin="120,180,0,0" VerticalAlignment="Top"
           Height="40" Width="185" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}" Click="Войти"/>

        <Button Content="Зарегистрироваться" HorizontalAlignment="Left"
           Margin="120,230,0,0" VerticalAlignment="Top"
           Height="40" Width="185" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}" Click="Зарегестрироваться"/>

        <Button Content="Войти как гость" HorizontalAlignment="Left"
           Margin="120,280,0,0" VerticalAlignment="Top"
           Height="40" Width="185" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}" Click="Войти_как_гость"/>
       
        <!--ВВОД ЛОГИНА-->
        <TextBox x:Name="LoginBox"
           HorizontalAlignment="Left" Margin="36,97,0,0"
           TextWrapping="Wrap" Text=""
           VerticalAlignment="Top" Height="40" Width="351"
           FontSize="16" BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"/>

        <Label Content="Введите логин:" HorizontalAlignment="Left"
           Margin="36,68,0,0" VerticalAlignment="Top"
           Height="40" Width="351" FontSize="16"
           FontFamily="Cambria" Background="{x:Null}"/>
    </Grid>
</Window>