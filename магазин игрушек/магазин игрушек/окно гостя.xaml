<Window x:Class="магазин_игрушек.окно_гостя"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
                Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="Гость" Height="600" Width="800">
    <Grid Background="#FFF4E1E1">
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>

        <Button Content="Фильтрация" Margin="40,0,655,0"
           VerticalAlignment="Top" Height="30" FontSize="16"
           BorderThickness="0" FontFamily="Cambria"
           Background="{x:Null}" Click="Фильтрация" />

        <ListBox x:Name="ProductsList"
                 Margin="0,79,0,0"
                 Background="White" BorderThickness="0"
                 FontFamily="Cambria" FontSize="14"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1"
                            Margin="0,0,0,10" Padding="10"
                            Background="White" Width="720" Height="90">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="200"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" BorderBrush="Black" BorderThickness="2"
                                    Width="80" Height="60" VerticalAlignment="Center">
                                <Image Source="{Binding FotoPath}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                           HorizontalAlignment="Center" Margin="0,0,0,3"/>
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding Quantity}" FontSize="12" Foreground="#333"/>
                                <TextBlock Text="{Binding Composition}" FontSize="12" Foreground="#333"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Price}"
                                       Foreground="{Binding PriceColor}"
                                       FontSize="20" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="15,0,0,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Label Content="Поиск:" HorizontalAlignment="Left"
           Margin="0,38,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <TextBox x:Name="SearchBox" HorizontalAlignment="Left"
          Margin="59,40,0,0" TextWrapping="Wrap" Text=""
          VerticalAlignment="Top" Width="400" Height="25"
          FontSize="16" BorderBrush="#FFDBB2EA"
          BorderThickness="2" FontFamily="Cambria"
          TextChanged="SearchBox_TextChanged"/>
    </Grid>
</Window>