<Window x:Class="магазин_игрушек.фильтрация"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:магазин_игрушек"
        mc:Ignorable="d"
                Icon="иконка.png" 
        ResizeMode="NoResize"
        Title="фильтрация" Height="450" Width="500">
    <Grid Background="#FFF4E1E1" >
        <Menu Height="30" VerticalAlignment="Top" Background="White"/>

        <Button Content="⬅"
           Panel.ZIndex="10"
           HorizontalAlignment="Left" VerticalAlignment="Top"
           Height="30" Width="40"
           FontSize="16"
           BorderThickness="0"
           FontFamily="Cambria"
           Background="White"
           Foreground="Black"
           Click="Button_Click"/>

        <!--ПРОИЗВОДИТЕЛЬ-->
        <Label Content="Производитель:" HorizontalAlignment="Left"
           Margin="30,50,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <CheckBox x:Name="Prod1"  Content=""
          HorizontalAlignment="Left" Margin="35,85,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Prod2" Content=""
          HorizontalAlignment="Left" Margin="35,105,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Prod3" Content=""
          HorizontalAlignment="Left" Margin="35,125,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Prod4"  Content=""
          HorizontalAlignment="Left" Margin="35,145,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Prod5"  Content=""
          HorizontalAlignment="Left" Margin="35,165,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>

        <!--МАТЕРИАЛ-->
        <Label Content="Материал:" HorizontalAlignment="Left"
           Margin="300,50,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <CheckBox x:Name="Mat1"  Content=""
          HorizontalAlignment="Left" Margin="305,85,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Mat2" Margin="305,105,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Mat3"  Content=""
          HorizontalAlignment="Left" Margin="305,125,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Mat4" Content=""
          HorizontalAlignment="Left" Margin="305,145,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>

        <!--НАПОЛНИТЕЛЬ-->
        <Label Content="Наполнитель:" HorizontalAlignment="Left"
           Margin="300,200,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <CheckBox x:Name="Nap1"  Content=""
          HorizontalAlignment="Left" Margin="305,235,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Nap2"  Content=""
          HorizontalAlignment="Left" Margin="305,255,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Nap3" Content=""
          HorizontalAlignment="Left" Margin="305,275,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>
        <CheckBox x:Name="Nap4"  Content=""
          HorizontalAlignment="Left" Margin="305,295,0,0" VerticalAlignment="Top"
          FontSize="13" FontFamily="Cambria"/>

        <!--СТОИМОСТЬ-->
        <Label Content="Стоимость:" HorizontalAlignment="Left"
           Margin="30,200,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <Label Content="От:" HorizontalAlignment="Left"
           Margin="35,235,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <TextBox x:Name="PriceFromBox" HorizontalAlignment="Left" Margin="68,235,0,0"
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"
           FontSize="16" BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"/>

        <Label Content="До:" HorizontalAlignment="Left"
           Margin="35,275,0,0" VerticalAlignment="Top"
           FontSize="16" FontFamily="Cambria"/>
        <TextBox x:Name="PriceToBox" HorizontalAlignment="Left" Margin="68,275,0,0"
           TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120"
           FontSize="16" BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}"/>

        <!--КНОПКА-->
        <Button Content="Пременить" HorizontalAlignment="Center"
           Margin="0,360,0,0" VerticalAlignment="Top"
           Height="35" Width="156" FontSize="16"
           BorderBrush="#FFDBB2EA" BorderThickness="2"
           FontFamily="Cambria" Background="{x:Null}" Click="Применить"/>

    </Grid>
</Window>